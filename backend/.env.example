# Server
PORT=4000
NODE_ENV=development

# MySQL
DATABASE_URL=mysql://scheduler:scheduler@localhost:3307/email_scheduler

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Rate limiting (all configurable, no hardcoding per spec)
MAX_EMAILS_PER_HOUR=200
# Optional per-sender override; falls back to MAX_EMAILS_PER_HOUR if unset
MAX_EMAILS_PER_HOUR_PER_SENDER=

# Minimum delay between sends, in ms (documented in README)
MIN_SEND_DELAY_MS=2000

# Worker
WORKER_CONCURRENCY=5

# Reconciliation sweep
STUCK_PROCESSING_THRESHOLD_MS=300000   # 5 minutes

# Auth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend origin (CORS)
FRONTEND_URL=http://localhost:3000
