# Copy this file to .env and replace the placeholder values with your own local credentials.
# Keep your real secrets out of git.

DATABASE_URL=mysql://username:password@localhost:3307/email_scheduler

PORT=4000
NODE_ENV=development

REDIS_HOST=localhost
REDIS_PORT=6379

MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=

MIN_SEND_DELAY_MS=2000

WORKER_CONCURRENCY=5

STUCK_PROCESSING_THRESHOLD_MS=300000

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_secure_random_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

FRONTEND_URL=http://localhost:3000
